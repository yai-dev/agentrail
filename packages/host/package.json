{
  "name": "@agentrail/host",
  "version": "0.0.3",
  "description": "Generic host runtime and streaming utilities for Agentrail.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "default": "./dist/defaults.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentrail/events": "workspace:*",
    "@agentrail/knowledge": "workspace:*",
    "@agentrail/memo": "workspace:*",
    "@agentrail/orchestration": "workspace:*",
    "@agentrail/runtime-core": "workspace:*",
    "@agentrail/sandbox": "workspace:*",
    "@agentrail/skills": "workspace:*",
    "@agentrail/tools": "workspace:*",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yai-dev/agentrail.git",
    "directory": "packages/host"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
