{
  "name": "@agentrail/deep-research",
  "version": "0.0.14",
  "description": "Reusable Deep Research workflow package for Agentrail examples.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && tsc-alias && mkdir -p dist/prompts && cp src/prompts/*.md dist/prompts/",
    "typecheck": "tsc -b --pretty false --force",
    "test": "pnpm exec vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentrail/capabilities": "workspace:*",
    "@agentrail/core": "workspace:*",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsc-alias": "^1.8.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yai-dev/agentrail.git",
    "directory": "packages/deep-research"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
