{
  "name": "@agentrail/plugin-user-memory",
  "version": "0.0.2",
  "description": "Optional user-memory background consolidation plugin for Agentrail.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b --force",
    "dev": "tsc --watch",
    "typecheck": "tsc -b --pretty false --force",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentrail/host": "workspace:*",
    "@agentrail/memo": "workspace:*",
    "@agentrail/runtime-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yai-dev/agentrail.git",
    "directory": "packages/plugin-user-memory"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
