{
  "name": "@agentrail/deep-research-example",
  "version": "0.0.1",
  "private": true,
  "description": "Dedicated Deep Research example app for Agentrail.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b --force && mkdir -p dist/prompts && cp src/prompts/*.md dist/prompts/",
    "dev": "node --import=tsx/esm --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -b --force --pretty false"
  },
  "dependencies": {
    "@agentrail/config": "workspace:*",
    "@agentrail/deep-research": "workspace:*",
    "@agentrail/knowledge": "workspace:*",
    "@agentrail/memo": "workspace:*",
    "@agentrail/orchestration": "workspace:*",
    "@agentrail/runtime-core": "workspace:*",
    "@agentrail/sandbox": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.3"
  },
  "license": "Apache-2.0"
}
